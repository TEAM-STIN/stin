# main에서 직접 커밋하지 못하게 막는다.
#
# 브랜치 보호는 push 시점에야 막는다. 그때는 이미 main에서 한참 작업한 뒤라
# worktree 격리의 이점도 못 누린 상태다. 시작하는 순간에 막아야 규칙이 지켜진다.
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [ "$BRANCH" = "main" ]; then
  echo ""
  echo "✗ main에서 직접 커밋할 수 없습니다."
  echo "  → 브랜치를 만드세요:  git switch -c feat/<슬러그>"
  echo "    지금 수정한 내용은 그대로 따라옵니다."
  echo "  → 병렬로 굴린다면:    git worktree add ../stin-<이름> -b feat/<슬러그>"
  echo "                        cd ../stin-<이름> && scripts/worktree-up.sh"
  echo "  → 규칙: docs/workflow.md"
  echo ""
  exit 1
fi

pnpm exec lint-staged
pnpm exec turbo run typecheck test
