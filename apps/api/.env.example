DATABASE_URL="postgresql://stin:stin_dev_password@localhost:5432/stin?schema=public"

# 나중에 인증 이슈(#9) 때 채울 항목
JWT_SECRET="change-me-in-local-env"
JWT_EXPIRES_IN="7d"

# 서버 포트. 비우면 3001 (apps/web이 3000을 쓴다)
PORT=3001

# 로깅. 기본값을 쓰려면 아래 두 줄은 주석으로 둔다.
# LOG_LEVEL은 trace|debug|info|warn|error (기본: 개발 debug / 운영 info)
# LOG_LEVEL=debug
# JSON 로그 파일 경로 (기본: 레포 루트의 .logs/api.jsonl)
# LOG_FILE=
