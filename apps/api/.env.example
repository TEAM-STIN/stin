DATABASE_URL="postgresql://stin:stin_dev_password@localhost:5432/stin?schema=public"

# 나중에 인증 이슈(#9) 때 채울 항목
JWT_SECRET="change-me-in-local-env"
JWT_EXPIRES_IN="7d"

# 서버 포트. 비우면 3001 (apps/web이 3000을 쓴다)
PORT=3001

# 로깅. LOG_LEVEL은 trace|debug|info|warn|error, 비우면 개발은 debug / 운영은 info
LOG_LEVEL=
# JSON 로그 파일 경로. 비우면 레포 루트의 .logs/api.jsonl
LOG_FILE=
